# Copy this file to .env and fill in the four values under REQUIRED.
# NEVER commit .env (it is in .gitignore): it holds your keys.

# ============================== REQUIRED ======================================

# Your school's Canvas address: no trailing slash, no /api/v1.
CANVAS_BASE_URL=https://canvas.example.edu

# Canvas > Account > Settings > "+ New Access Token" (give it an expiry date).
CANVAS_API_TOKEN=

# The AI that writes the answers on the Ask page: gemini, claude or codex.
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# ====================== OPTIONAL: the defaults work ===========================

# A model for LLM_PROVIDER (blank = its default). The Ask page can switch per question.
LLM_MODEL=

# How hard the AI thinks before answering: medium or high (blank = medium).
# High is slower, for harder questions. The Ask page's menu starts here and can switch per question.
REASONING_LEVEL=

# Due dates are shown in this time zone (an IANA name).
TIMEZONE=America/Chicago

# Only these course IDs, comma-separated (blank = all), and which enrollments to include.
CANVAS_COURSE_IDS=
CANVAS_ENROLLMENT_STATES=active

# Embeddings run on your computer, no key: local = all-MiniLM-L6-v2 (run `acad setup` once);
# hash = an offline test mode that matches shared words, not meaning.
EMBEDDING_BACKEND=local

# Chunk size target in characters, and overlap. After changing them: acad embed --rebuild
CHUNK_CHARS=1000
CHUNK_OVERLAP=150

# How many passages the Search page shows.
TOP_K=10

# Where your courses, the index and the manifest are saved.
DATA_DIR=./data

# The largest document you can add to a course yourself (a textbook PDF can be big).
MAX_UPLOAD_MB=200

# The web server (`acad serve`). If port 8000 is taken, pick another, e.g. 8765.
API_HOST=127.0.0.1
API_PORT=8000

# Other web origins allowed to call the API (only for a separate front end).
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
